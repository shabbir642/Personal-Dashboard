# Backend environment configuration

# Database and logging
DATABASE_URL=sqlite:///./task_dashboard.db
LOG_LEVEL=INFO

# CORS (comma-separated origins)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Task description bounds
TASK_DESCRIPTION_MIN_LENGTH=30
TASK_DESCRIPTION_MAX_LENGTH=5000

# AI enrichment feature
TASK_AI_ENRICHMENT_ENABLED=true
TASK_AI_PROVIDER=mock
TASK_AI_MODEL=gpt-4.1-mini

# Required only when TASK_AI_PROVIDER=openai
TASK_AI_OPENAI_API_KEY=
